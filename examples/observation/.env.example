# Langfuse credentials, from your project settings (https://cloud.langfuse.com
# or your self-hosted instance). Copy this file to .env and fill the keys; the
# example then sends its traces to Langfuse. Without them it prints the spans
# to the console instead, so it stays runnable offline.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
